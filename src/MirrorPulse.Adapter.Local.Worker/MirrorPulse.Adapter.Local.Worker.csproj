<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MirrorPulse.Adapter.Sdk" Condition="'$(LocalAtomicSdkProject)' == ''" />
    <ProjectReference Include="$(LocalAtomicSdkProject)" Condition="'$(LocalAtomicSdkProject)' != ''" />
  </ItemGroup>

  <PropertyGroup Condition="'$(LocalAtomicSdkProject)' != ''">
    <DefineConstants>$(DefineConstants);LOCAL_ATOMIC_DIRECTORY_CANDIDATE</DefineConstants>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup Condition="'$(LocalAtomicSdkProject)' != ''">
    <Compile Include="../../tools/MirrorPulse.Adapter.Local.DirectoryEffectsProbe/LocalAtomicDirectory*.cs" Link="Candidate/%(Filename)%(Extension)" />
    <Compile Include="../../tools/MirrorPulse.Adapter.Local.DirectoryEffectsProbe/AtomicDirectory*.cs" Link="Candidate/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
